---
import { marked } from 'marked';
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

{
    (hero?.title || hero?.image?.src || hero?.text || (hero?.actions && hero.actions.length > 0)) && (
        <section class="w-full flex flex-col gap-8 mb-16 sm:mb-16">
            {/* <h2 class="text-lg leading-tight font-serif font-medium sm:text-xl sm:leading-tight">Hi! I'm Manith</h2> */}
            {hero.title && <h1 class="text-2xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{hero.title}</h1>}
            <h3
                class="text-lg leading-tight font-serif font-medium sm:text-xl sm:leading-tight justify-self-center"
                style="display: flex; justify-content: center;"
            >
                Computer Engineering Undergraduate | Volunteer in Tech | AI & Data Science Enthusiast
            </h3>
            <div class="flex flex-col sm:flex-row sm:items-start sm:gap-8">
  {hero.image?.src && (
    <figure class="sm:w-1/2">
      <img
        class="w-full mb-8 rounded-3xl"
        src={hero.image.src}
        loading="lazy"
        decoding="async"
        alt={hero.image.alt || ''}
      />
      {hero.image.caption && (
        <figcaption class="mt-1.5 text-xs sm:text-sm">
          {hero.image.caption}
        </figcaption>
      )}
    </figure>
  )}
  <div class="sm:w-1/2">
    {hero.text && (
      <div class="mb-4 max-w-none prose prose-dante sm:prose-lg text-justify" set:html={marked.parse(hero.text)} />
    )}
    {hero.actions && hero.actions.length > 0 && (
      <div class="flex flex-wrap gap-4">
        {hero.actions.map((action) => (
          <Button href={action.href}>{action.text}</Button>
        ))}
      </div>
    )}
  </div>
</div>
        </section>
    )
}
